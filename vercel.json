{
  "version": 2,
  "name": "timeflo-arcade",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/games/story/the-last-alibi",
      "destination": "/games/story/the-last-alibi/dist/index.html"
    },
    {
      "source": "/games/story/the-last-alibi/",
      "destination": "/games/story/the-last-alibi/dist/index.html"
    },
    {
      "source": "/games/story/the-last-alibi/index.html",
      "destination": "/games/story/the-last-alibi/dist/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
