# Environment Variables for Timeflo Arcade (Vercel)
# Add this in your Vercel Project Settings -> Environment Variables

# Google Gemini API Key for Tarot & Tea AI Oracle Readings
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
